# BigCommerce App Credentials
# Create your app at: https://developer.bigcommerce.com/
BC_CLIENT_ID=your_app_client_id
BC_CLIENT_SECRET=your_app_client_secret

# Callback URLs (must match exactly what you register in the Dev Portal)
BC_AUTH_CALLBACK=https://your-app.com/auth
BC_LOAD_CALLBACK=https://your-app.com/load
BC_UNINSTALL_CALLBACK=https://your-app.com/uninstall

# App URL (where this backend is hosted)
APP_URL=https://your-app.com

# Session secret - generate a random 32+ char string
SESSION_SECRET=change_me_to_a_random_secret_string

# Webhook secret - a long random string sent as a custom header on every
# BigCommerce webhook and verified by the receiver. BigCommerce does NOT
# HMAC-sign webhook bodies, so this shared-secret header is how callbacks are
# authenticated. If you rotate this value, re-create the webhooks (the app
# re-syncs the header automatically on the next bundle create/edit).
WEBHOOK_SECRET=change_me_to_another_random_secret_string

# Port
PORT=3000

# Environment
NODE_ENV=production

# SQLite database path (optional — defaults to <project-root>/data/bundles.db)
# Override if your hosting platform requires a specific persistent volume mount.
# Example for Railway with a mounted volume: DB_PATH=/data/bundles.db
# DB_PATH=/data/bundles.db
